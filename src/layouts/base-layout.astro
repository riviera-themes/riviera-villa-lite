---
import '../styles/global.css';
import SeoHead from '../components/seo-head.astro';
import SiteFooter from '../components/site-footer.astro';
import SiteHeader from '../components/site-header.astro';
import { villa } from '../config/index.ts';
import { useI18n, type LayoutPage } from '../i18n/index.ts';
import type { Locale } from '../i18n/locales.ts';

interface Props {
  locale: Locale;
  page: LayoutPage;
  title: string;
  description: string;
  noindex?: boolean;
}

const { locale, page, title, description, noindex } = Astro.props;
const { ui, bcp47 } = useI18n(locale);
const { colors, fonts } = villa.theme;
const themeVars = [
  `--rt-bg:${colors.background}`,
  `--rt-surface:${colors.surface}`,
  `--rt-text:${colors.text}`,
  `--rt-accent:${colors.accent}`,
  `--rt-hero-accent:${colors.heroAccent}`,
  `--rt-font-heading:${fonts.heading}`,
  `--rt-font-body:${fonts.body}`,
].join(';');
---

<!doctype html>
<html lang={bcp47} style={themeVars}>
  <head>
    <SeoHead locale={locale} page={page} title={title} description={description} noindex={noindex} />
  </head>
  <body class="bg-cream text-ink">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-surface focus:px-5 focus:py-3 focus:shadow-lg"
      >{ui.skipToContent}</a
    >
    <SiteHeader locale={locale} page={page} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter locale={locale} page={page} />
  </body>
</html>
