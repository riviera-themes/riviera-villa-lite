---
/** Round flag of a language, drawn inline. Decorative: the language name always sits next to it. */
import { villa } from '../config/index.ts';
import { FLAG_SVG, flagFor } from '../i18n/flags.ts';
import type { Locale } from '../i18n/locales.ts';

interface Props {
  locale: Locale;
  size?: number;
}

const { locale, size = 22 } = Astro.props;
const code = flagFor(locale, villa.languages.flags);
---

<span class="flag" style={`width:${size}px;height:${size}px`} aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" width={size} height={size} focusable="false" set:html={FLAG_SVG[code]}></svg>
</span>

<style>
  .flag {
    display: inline-block;
    flex-shrink: 0;
    border-radius: 999px;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgb(20 16 12 / 0.12);
    line-height: 0;
  }

  .flag svg {
    display: block;
  }
</style>
