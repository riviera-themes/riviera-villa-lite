---
import { villa } from '../config/index.ts';
import { frenchSpacing, useI18n } from '../i18n/index.ts';
import type { Locale } from '../i18n/locales.ts';
import Icon from './icon.astro';
import SectionHeading from './section-heading.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { ui, t, decimal, month } = useI18n(locale);
const { rating, reviews } = villa;
---

<section id="reviews" class="wrap py-[clamp(88px,11vw,150px)]" aria-labelledby="reviews-title">
  <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
    <SectionHeading id="reviews-title" eyebrow={ui.sections.reviews.eyebrow} title={ui.sections.reviews.title} />
    {
      rating && (
        <div class="flex items-end gap-5">
          <p class="font-serif text-[76px] leading-[0.85]">{decimal(rating.value)}</p>
          <div class="pb-1">
            <p class="flex gap-[2px] text-accent" role="img" aria-label={`${decimal(rating.value)} ${ui.reviews.outOf}`}>
              {Array.from({ length: 5 }, () => (
                <Icon name="star" size={17} />
              ))}
            </p>
            <p class="mt-2 text-[14px] text-muted">{ui.reviews.basedOn(rating.count, rating.source)}</p>
          </div>
        </div>
      )
    }
  </div>

  <ul class="mt-12 grid gap-4 md:grid-cols-2" role="list">
    {
      reviews.map((r) => (
        <li class="flex flex-col rounded-[22px] bg-surface p-8 sm:p-10">
          <p class="flex gap-[2px] text-accent" role="img" aria-label={`${r.rating} ${ui.reviews.outOf}`}>
            {Array.from({ length: Math.round(r.rating) }, () => (
              <Icon name="star" size={14} />
            ))}
          </p>
          <blockquote lang={r.lang} class="mt-5 flex-1 font-serif text-[23px] leading-[1.4]">
            <p>{r.lang === 'fr' ? frenchSpacing(r.text) : r.text}</p>
          </blockquote>
          <footer class="mt-7 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t border-line pt-5 text-[14px]">
            <span>
              <b class="font-semibold">{r.author}</b>
              {r.origin && <span class="text-muted"> · {t(r.origin)}</span>}
            </span>
            <span class="text-muted">{ui.reviews.stayed(month(r.date))}</span>
          </footer>
        </li>
      ))
    }
  </ul>
</section>
