---
import { getImage } from 'astro:assets';
import { villa } from '../config/index.ts';
import { linkablePage, pageUrl, type LayoutPage } from '../i18n/index.ts';
import { LOCALE_META, type Locale } from '../i18n/locales.ts';
import { photo } from '../lib/photos.ts';

interface Props {
  locale: Locale;
  page: LayoutPage;
  title: string;
  description: string;
  noindex?: boolean;
}

const { locale, page, title, description, noindex = false } = Astro.props;
const canonical = pageUrl(locale, linkablePage(page));
const active = villa.languages.active;
const share = await getImage({ src: photo(villa.seo.shareImage), width: 1200, height: 630, format: 'jpg', quality: 80 });
const shareUrl = new URL(share.src, villa.site.url).toString();

---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
{
  !noindex &&
    active.length > 1 &&
    active.map((l) => <link rel="alternate" hreflang={LOCALE_META[l].bcp47} href={pageUrl(l, linkablePage(page))} />)
}
{!noindex && active.length > 1 && <link rel="alternate" hreflang="x-default" href={pageUrl(villa.languages.default, linkablePage(page))} />}
<meta name="theme-color" content={villa.theme.colors.background} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={villa.property.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={shareUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
{active.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />)}
<meta name="twitter:card" content="summary_large_image" />

