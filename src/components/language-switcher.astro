---
/** Full list of languages with their flags: phone menu and footer. Hidden with a single language. */
import { villa } from '../config/index.ts';
import { linkablePage, pagePath, useI18n, type LayoutPage } from '../i18n/index.ts';
import { LOCALE_META, type Locale } from '../i18n/locales.ts';
import Flag from './flag.astro';

interface Props {
  locale: Locale;
  page: LayoutPage;
  /** One language per line (footer) instead of a wrapping row (phone menu). */
  vertical?: boolean;
}

const { locale, page, vertical = false } = Astro.props;
const { ui } = useI18n(locale);
const languages = villa.languages.active;
---

{
  languages.length > 1 && (
    <nav aria-label={ui.nav.language}>
      <ul
        class:list={['flex', vertical ? 'flex-col items-start gap-3 text-[15px]' : 'flex-wrap gap-x-6 gap-y-3 text-[16px]']}
        role="list"
      >
        {languages.map((l) => (
          <li>
            <a
              href={pagePath(l, linkablePage(page))}
              lang={LOCALE_META[l].bcp47}
              hreflang={LOCALE_META[l].bcp47}
              aria-current={l === locale ? 'page' : undefined}
              class:list={[
                'inline-flex items-center gap-[10px] transition-colors hover:text-ink',
                l === locale ? 'font-semibold text-ink' : 'text-muted',
                !vertical && 'py-2',
              ]}
            >
              <Flag locale={l} size={vertical ? 18 : 22} />
              {LOCALE_META[l].nativeName}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
