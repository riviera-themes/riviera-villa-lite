---
/**
 * Language button of the menu pill: the flag of the current language opens a short list of the
 * other ones. Hidden when only one language is active. Phones use the list in the full-screen menu.
 */
import { villa } from '../config/index.ts';
import { linkablePage, pagePath, useI18n, type LayoutPage } from '../i18n/index.ts';
import { LOCALE_META, type Locale } from '../i18n/locales.ts';
import Flag from './flag.astro';
import Icon from './icon.astro';

interface Props {
  locale: Locale;
  page: LayoutPage;
}

const { locale, page } = Astro.props;
const { ui } = useI18n(locale);
const languages = villa.languages.active;
const listId = 'language-menu-list';
---

{
  languages.length > 1 && (
    <div class="lang-menu relative" data-lang-menu>
      <button
        type="button"
        class="lang-button"
        aria-expanded="false"
        aria-controls={listId}
        aria-label={ui.nav.currentLanguage(LOCALE_META[locale].nativeName)}
        data-lang-button
      >
        <Flag locale={locale} size={24} />
        <Icon name="chevron-down" size={14} class="lang-chevron" />
      </button>
      <ul id={listId} class="lang-list" role="list" hidden data-lang-list>
        {languages.map((l) => (
          <li>
            <a
              href={pagePath(l, linkablePage(page))}
              lang={LOCALE_META[l].bcp47}
              hreflang={LOCALE_META[l].bcp47}
              aria-current={l === locale ? 'page' : undefined}
              class="lang-item"
            >
              <Flag locale={l} size={20} />
              <span class="flex-1">{LOCALE_META[l].nativeName}</span>
              {l === locale && <Icon name="check" size={16} class="text-accent-ink" />}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<script>
  import { initLanguageMenu } from '../scripts/language-menu.ts';

  document.querySelectorAll<HTMLElement>('[data-lang-menu]').forEach(initLanguageMenu);
</script>

<style>
  .lang-button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px 6px 7px;
    border-radius: 999px;
    border: 1px solid var(--rt-line);
    background: var(--rt-surface);
    transition: border-color 160ms ease;
  }

  .lang-button:hover,
  .lang-button[aria-expanded='true'] {
    border-color: var(--rt-line-strong);
  }

  .lang-button :global(.lang-chevron) {
    color: var(--rt-muted);
    transition: transform 160ms ease;
  }

  .lang-button[aria-expanded='true'] :global(.lang-chevron) {
    transform: rotate(180deg);
  }

  .lang-list {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    min-width: 196px;
    padding: 8px;
    border-radius: 18px;
    background: var(--rt-surface);
    box-shadow: 0 16px 40px rgb(20 16 12 / 0.16);
    z-index: 60;
  }

  .lang-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 12px;
    font-size: 14.5px;
    color: var(--rt-text);
  }

  .lang-item:hover,
  .lang-item:focus-visible {
    background: var(--rt-sand);
  }

  .lang-item[aria-current='page'] {
    font-weight: 600;
  }
</style>
