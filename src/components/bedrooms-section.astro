---
import { Image } from 'astro:assets';
import { villa } from '../config/index.ts';
import { useI18n } from '../i18n/index.ts';
import type { Locale } from '../i18n/locales.ts';
import { photo } from '../lib/photos.ts';
import Icon from './icon.astro';
import SectionHeading from './section-heading.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { ui, t } = useI18n(locale);
const { images, rooms } = villa.bedrooms;
---

<section id="bedrooms" class="border-t border-line bg-sand py-[clamp(88px,11vw,150px)]" aria-labelledby="bedrooms-title">
  <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-6">
      <SectionHeading id="bedrooms-title" eyebrow={ui.sections.bedrooms.eyebrow} title={ui.sections.bedrooms.title} />
      <ol class="mt-12 border-t border-line-strong">
        {
          rooms.map((room, i) => (
            <li class="grid grid-cols-[44px_1fr] gap-x-2 border-b border-line py-7">
              <span class="num pt-[6px]" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="text-[28px] leading-[1.1]">{t(room.name)}</h3>
                <p class="mt-3 flex items-start gap-2 text-[15px] font-medium">
                  <Icon name="bed" size={18} class="mt-[2px] shrink-0 text-accent-ink" />
                  {t(room.beds)}
                </p>
                <p class="mt-1 text-[14.5px] leading-[1.6] text-muted">{t(room.details)}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    {
      images.length > 0 && (
        <div class="grid content-start gap-4 sm:grid-cols-2 lg:col-span-6 lg:grid-cols-1 lg:pl-6">
          {images.map((img, i) => (
            <Image
              src={photo(img.image)}
              alt={t(img.alt)}
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 1024px) 44vw, (min-width: 640px) 46vw, 92vw"
              class:list={['aspect-[3/2] w-full rounded-[20px] object-cover', i === 1 && 'lg:ml-auto lg:w-[72%]']}
            />
          ))}
        </div>
      )
    }
  </div>
</section>
