---
import { Image } from 'astro:assets';
import { villa } from '../config/index.ts';
import { useI18n } from '../i18n/index.ts';
import type { Locale } from '../i18n/locales.ts';
import { photo } from '../lib/photos.ts';
import BookingBar from './booking-bar.astro';
import RichTitle from './rich-title.astro';
import TrustLine from './trust-line.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = useI18n(locale);
const { hero } = villa;
---

<section class="hero relative px-3 pt-3 sm:px-[22px] sm:pt-[22px]" aria-labelledby="hero-title">
  <div class="hero-photo relative overflow-hidden rounded-[18px] sm:rounded-[22px]">
    <Image
      src={photo(hero.image)}
      alt={t(hero.imageAlt)}
      widths={[640, 960, 1280, 1600, 2000, 2400]}
      sizes="calc(100vw - 44px)"
      priority
      class="absolute inset-0 h-full w-full object-cover"
      style="object-position: center 30%;"
    />
    <div class="hero-shade absolute inset-0" aria-hidden="true"></div>
    <div class="hero-text absolute inset-x-0 z-[2] px-6 text-white sm:px-[58px]">
      <p class="text-[12px] font-semibold uppercase tracking-[0.12em] opacity-95 sm:text-[14px]">{t(hero.eyebrow)}</p>
      <h1 id="hero-title" class="mt-[10px] text-[clamp(44px,6.6vw,88px)] leading-[1]">
        <RichTitle text={t(hero.title)} />
      </h1>
    </div>
  </div>
  <div class="bar-slot relative z-[3] mx-auto sm:px-[58px]">
    <BookingBar locale={locale} />
  </div>
  <div class="mx-auto sm:px-[58px]">
    <TrustLine locale={locale} />
  </div>
</section>

<style>
  .hero-photo {
    height: clamp(520px, calc(100svh - 172px), 780px);
  }

  .hero-shade {
    background: linear-gradient(
      180deg,
      rgb(20 16 12 / 0.28) 0%,
      rgb(20 16 12 / 0) 32%,
      rgb(20 16 12 / 0.06) 55%,
      rgb(20 16 12 / 0.5) 100%
    );
  }

  .hero-text {
    bottom: 148px;
    text-shadow: 0 1px 24px rgb(20 16 12 / 0.25);
  }

  .hero-text :global(em) {
    font-style: italic;
    color: var(--rt-hero-accent);
  }

  .bar-slot {
    margin-top: -38px;
  }

  @media (max-width: 767px) {
    .hero-photo {
      height: clamp(500px, calc(100svh - 120px), 640px);
    }

    .hero-text {
      bottom: 92px;
    }

    .bar-slot {
      margin-top: -64px;
      padding-inline: 12px;
    }
  }
</style>
