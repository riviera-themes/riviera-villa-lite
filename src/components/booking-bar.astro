---
import { villa } from '../config/index.ts';
import { pagePath, useI18n } from '../i18n/index.ts';
import type { Locale } from '../i18n/locales.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { ui } = useI18n(locale);
const max = villa.property.capacity.guests;
const guestOptions = Array.from({ length: max }, (_, i) => i + 1);
const target = villa.features.calendar && villa.sections.availability ? '#availability' : '#booking';
---

<form
  data-booking-bar
  data-target={target}
  action={pagePath(locale, 'home', '#booking')}
  method="get"
  class="bar"
  aria-label={ui.bar.label}
>
  <label class="bar-field" data-date-field>
    <span class="bar-caption">{ui.bar.arrival}</span>
    <span class="bar-value" data-display data-empty="true">{ui.bar.addDate}</span>
    <input type="date" name="arrival" class="bar-input" data-arrival />
  </label>
  <label class="bar-field" data-date-field>
    <span class="bar-caption">{ui.bar.departure}</span>
    <span class="bar-value" data-display data-empty="true">{ui.bar.addDate}</span>
    <input type="date" name="departure" class="bar-input" data-departure />
  </label>
  <label class="bar-field bar-guests">
    <span class="bar-caption">{ui.bar.guests}</span>
    <select name="guests" class="bar-select" data-guests>
      {guestOptions.map((n) => <option value={n} selected={n === Math.min(2, max)}>{ui.common.guests(n)}</option>)}
    </select>
  </label>
  <button type="submit" class="btn btn-accent bar-go">{ui.bar.search}</button>
</form>

<script>
  import { initBookingBar } from '../scripts/booking-bar.ts';

  document.querySelectorAll<HTMLFormElement>('[data-booking-bar]').forEach(initBookingBar);
</script>

<style>
  .bar {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr auto;
    align-items: center;
    background: var(--rt-surface);
    border-radius: 999px;
    padding: 10px 10px 10px 34px;
    box-shadow: 0 14px 40px rgb(0 0 0 / 0.14);
  }

  .bar-field {
    position: relative;
    display: block;
    min-width: 0;
    border-right: 1px solid var(--rt-line);
    padding: 4px 18px 4px 0;
    margin-right: 18px;
    cursor: pointer;
  }

  .bar-guests {
    border-right: 0;
  }

  .bar-field:focus-within {
    outline: 2px solid var(--rt-accent);
    outline-offset: 4px;
  }

  .bar-caption {
    display: block;
    font-size: 12px;
    color: var(--rt-muted);
  }

  .bar-value,
  .bar-input,
  .bar-select {
    display: block;
    width: 100%;
    font-size: 15px;
    font-weight: 500;
    color: var(--rt-text);
    background: transparent;
    border: 0;
    padding: 0;
    line-height: 1.5;
  }

  .bar-value {
    display: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bar-value[data-empty='true'] {
    color: var(--rt-muted);
    font-weight: 400;
  }

  .bar-input:focus,
  .bar-select:focus {
    outline: none;
  }

  .bar-select {
    appearance: none;
    cursor: pointer;
  }

  /* With JavaScript: the date is shown as text ("Sat. 12 July") over the native date picker. */
  .bar[data-enhanced] .bar-value {
    display: block;
  }

  .bar[data-enhanced] .bar-input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .bar-go {
    padding: 16px 26px;
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .bar {
      grid-template-columns: 1fr 1fr;
      gap: 4px 0;
      border-radius: 22px;
      padding: 14px;
    }

    .bar-field {
      padding: 8px 10px;
      margin: 0;
    }

    .bar-field:nth-child(2) {
      border-right: 0;
    }

    .bar-guests {
      grid-column: 1 / -1;
      border-top: 1px solid var(--rt-line);
      border-radius: 0;
    }

    .bar-go {
      grid-column: 1 / -1;
      margin-top: 8px;
      width: 100%;
    }
  }
</style>
