---
import { Image } from 'astro:assets';
import { villa } from '../config/index.ts';
import { useI18n } from '../i18n/index.ts';
import type { Locale } from '../i18n/locales.ts';
import { photo } from '../lib/photos.ts';
import Icon from './icon.astro';
import SectionHeading from './section-heading.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { ui, t } = useI18n(locale);
const { area, property } = villa;
const [bigImage, smallImage] = area.images;
const { latitude, longitude } = property.geo;
// A plain link to OpenStreetMap: no embedded map, so no third-party request or cookie on the page.
const mapUrl = `https://www.openstreetmap.org/?mlat=${latitude}&mlon=${longitude}#map=13/${latitude}/${longitude}`;
---

<section id="area" class="border-t border-line py-[clamp(88px,11vw,150px)]" aria-labelledby="area-title">
  <div class="wrap grid gap-14 lg:grid-cols-12 lg:gap-12">
    <div class="lg:col-span-5">
      <SectionHeading id="area-title" eyebrow={ui.area.eyebrow} title={t(area.title)} intro={t(area.intro)}>
        <a href={mapUrl} class="btn btn-ghost mt-8" rel="noopener" target="_blank">
          <Icon name="pin" size={18} />
          {ui.area.openMap}
        </a>
      </SectionHeading>
      <Image
        src={photo(smallImage.image)}
        alt={t(smallImage.alt)}
        widths={[360, 540, 720, 960]}
        sizes="(min-width: 1024px) 34vw, 92vw"
        class="mt-12 aspect-[4/3] w-full rounded-[18px] object-cover lg:aspect-[4/5]"
      />
    </div>
    <div class="lg:col-span-7">
      <Image
        src={photo(bigImage.image)}
        alt={t(bigImage.alt)}
        widths={[540, 720, 960, 1280, 1600]}
        sizes="(min-width: 1024px) 52vw, 92vw"
        class="aspect-[3/2] w-full rounded-[20px] object-cover"
      />
      <ul class="mt-10 border-t border-line-strong" role="list">
        {
          area.places.map((p) => (
            <li class="grid grid-cols-[1fr_auto] items-baseline gap-x-6 border-b border-line py-[18px]">
              <div>
                <span class="font-serif text-[24px] leading-[1.15]">{p.name}</span>
                <span class="block text-[13.5px] text-muted sm:ml-3 sm:inline">{t(p.kind)}</span>
                {p.text && <p class="mt-1 text-[14px] text-muted">{t(p.text)}</p>}
              </div>
              <span class="text-[14.5px] tabular-nums whitespace-nowrap">{t(p.distance)}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
