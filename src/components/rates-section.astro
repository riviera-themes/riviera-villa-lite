---
import { villa } from '../config/index.ts';
import { useI18n } from '../i18n/index.ts';
import type { Locale } from '../i18n/locales.ts';
import SectionHeading from './section-heading.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { ui, t, money } = useI18n(locale);
const { rates, property } = villa;
---

<section id="rates" class="border-t border-line bg-sand py-[clamp(88px,11vw,150px)]" aria-labelledby="rates-title">
  <div class="wrap">
    <SectionHeading
      id="rates-title"
      eyebrow={ui.sections.rates.eyebrow}
      title={ui.sections.rates.title}
      intro={t(rates.intro)}
    />

    <table class="mt-12 w-full border-t border-line-strong text-left">
      <caption class="sr-only">{ui.sections.rates.title}</caption>
      <thead class="sr-only">
        <tr>
          <th scope="col">{ui.rates.season}</th>
          <th scope="col">{ui.rates.minStayLabel}</th>
          <th scope="col">{ui.rates.nightly}</th>
        </tr>
      </thead>
      <tbody>
        {
          rates.seasons.map((s, i) => (
            <tr class="season-row border-b border-line">
              <th scope="row" class="py-7 pr-6 align-top font-normal">
                <span class="flex items-baseline gap-3">
                  <span class="num !text-[18px]" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span>
                    <span class="block font-serif text-[28px] leading-[1.1]">{t(s.name)}</span>
                    <span class="mt-1 block text-[14.5px] text-muted">{t(s.period)}</span>
                    {s.note && <span class="mt-1 block text-[14px] text-accent-ink">{t(s.note)}</span>}
                  </span>
                </span>
              </th>
              <td class="season-min py-7 pr-6 align-top text-[14.5px] text-muted">{ui.rates.minStay(s.minNights)}</td>
              <td class="py-7 text-right align-top whitespace-nowrap">
                <span class="font-serif text-[36px] leading-none">{money(s.nightly)}</span>
                <span class="mt-1 block text-[13px] text-muted">{ui.trust.perNight}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <div class="mt-14 grid gap-10 md:grid-cols-3">
      {
        rates.extras.length > 0 && (
          <div>
            <h3 class="text-[24px]">{ui.rates.extras}</h3>
            <dl class="mt-4 border-t border-line">
              {rates.extras.map((x) => (
                <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-x-6 border-b border-line py-3 text-[14.5px]">
                  <dt class="text-muted">{t(x.label)}</dt>
                  <dd class="max-w-[220px] text-right font-medium">{t(x.value)}</dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }
      <div>
        <h3 class="text-[24px]">{ui.rates.touristTax}</h3>
        <p class="mt-4 border-t border-line pt-4 text-[14.5px] leading-[1.65] text-muted">{t(rates.touristTax)}</p>
      </div>
      <div>
        <h3 class="text-[24px]">{ui.rates.payment}</h3>
        <p class="mt-4 border-t border-line pt-4 text-[14.5px] leading-[1.65] text-muted">{t(rates.payment)}</p>
        <p class="mt-3 text-[14.5px] font-medium">{ui.rates.checkInOut(property.checkIn, property.checkOut)}</p>
      </div>
    </div>
  </div>
</section>

<style>
  @media (max-width: 639px) {
    .season-row {
      display: grid;
      grid-template-columns: 1fr auto;
    }

    .season-row th {
      grid-column: 1 / -1;
      padding-bottom: 8px;
    }

    .season-min {
      padding-top: 0;
    }

    .season-row td:last-child {
      padding-top: 0;
    }
  }
</style>
