---
import { villa } from '../config/index.ts';
import { useI18n } from '../i18n/index.ts';
import type { Locale } from '../i18n/locales.ts';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { ui, t, money, decimal } = useI18n(locale);
const { capacity } = villa.property;
const fromPrice = Math.min(...villa.rates.seasons.map((s) => s.nightly));
const highlight = t(villa.hero.highlight);
const facts = [ui.trust.bedrooms(capacity.bedrooms), ui.trust.guests(capacity.guests), highlight].filter(Boolean).join(' · ');
const reviewsHref = villa.sections.reviews ? '#reviews' : undefined;
---

<ul class="trust" role="list">
  {
    villa.rating && (
      <li>
        <a href={reviewsHref} class="hover:text-ink">
          <b>★ {decimal(villa.rating.value)}</b> · {ui.trust.reviewsOn(villa.rating.count, villa.rating.source)}
        </a>
      </li>
    )
  }
  <li>{ui.trust.from} <b>{money(fromPrice)} {ui.trust.perNight}</b></li>
  <li>{facts}</li>
  <li>{ui.trust.noFees}</li>
</ul>

<style>
  .trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 0;
    padding-block: 52px 34px;
    font-size: 14.5px;
    color: color-mix(in oklab, var(--rt-text) 82%, var(--rt-bg));
  }

  .trust li {
    padding-inline: 17px;
    border-left: 1px solid var(--rt-line-strong);
  }

  .trust li:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .trust b {
    font-weight: 600;
    color: var(--rt-text);
  }

  /* Phones: one fact per line, so no item is ever cut or pushed aside. */
  @media (max-width: 767px) {
    .trust {
      flex-direction: column;
      align-items: flex-start;
      gap: 9px;
      padding: 24px 14px 8px;
      font-size: 14px;
    }

    .trust li,
    .trust li:first-child {
      padding: 0 0 0 14px;
      border: 0;
      position: relative;
    }

    .trust li::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0.55em;
      width: 5px;
      height: 5px;
      border-radius: 999px;
      background: var(--rt-accent);
    }
  }
</style>
