---
import { getImage, Image } from 'astro:assets';
import { villa } from '../config/index.ts';
import { useI18n } from '../i18n/index.ts';
import type { Locale } from '../i18n/locales.ts';
import { photo } from '../lib/photos.ts';
import Icon from './icon.astro';
import SectionHeading from './section-heading.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { ui, t } = useI18n(locale);
const total = villa.gallery.length;

const items = await Promise.all(
  villa.gallery.map(async (g) => {
    const large = await getImage({ src: photo(g.image), width: 2000, format: 'webp', quality: 82 });
    return { ...g, alt: t(g.alt), large: large.src };
  }),
);
---

<section id="gallery" class="wrap pb-[clamp(88px,11vw,150px)]" aria-labelledby="gallery-title">
  <SectionHeading id="gallery-title" eyebrow={ui.sections.gallery.eyebrow} title={ui.sections.gallery.title} />

  <ul class="mt-12 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3" role="list" data-gallery>
    {
      items.map((item, i) => (
        <li>
          <a
            href={item.large}
            class="group block overflow-hidden rounded-[16px] bg-sand"
            data-index={i}
            data-alt={item.alt}
            aria-label={ui.gallery.open(i + 1, total)}
          >
            <Image
              src={photo(item.image)}
              alt={item.alt}
              widths={[360, 540, 720, 960]}
              sizes="(min-width: 1024px) 31vw, 48vw"
              class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
            />
          </a>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" aria-label={ui.gallery.dialogLabel} data-lightbox>
    <div class="flex h-full flex-col">
      <div class="flex items-center justify-between px-5 py-4 text-[14px] sm:px-8">
        <span data-counter aria-live="polite"></span>
        <button type="button" class="btn btn-ghost !px-4 !py-[9px] !text-[14px]" data-close>
          <Icon name="close" size={18} />
          {ui.gallery.close}
        </button>
      </div>
      <figure class="relative flex min-h-0 flex-1 flex-col items-center justify-center px-4 pb-6 sm:px-20">
        <img data-image alt="" class="max-h-full max-w-full rounded-[14px] object-contain" />
        <figcaption data-caption class="mt-4 text-center text-[14px] text-muted"></figcaption>
        <button type="button" class="lightbox-nav left-3 sm:left-6" data-prev aria-label={ui.gallery.previous}>
          <Icon name="arrow-left" />
        </button>
        <button type="button" class="lightbox-nav right-3 sm:right-6" data-next aria-label={ui.gallery.next}>
          <Icon name="arrow-right" />
        </button>
      </figure>
    </div>
  </dialog>
</section>

<script>
  import { initLightbox } from '../scripts/lightbox.ts';

  const list = document.querySelector<HTMLElement>('[data-gallery]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (list && dialog) initLightbox(list, dialog);
</script>

<style>
  .lightbox {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    background: var(--rt-bg);
    color: var(--rt-text);
  }

  .lightbox::backdrop {
    background: var(--rt-bg);
  }

  .lightbox img {
    max-height: calc(100svh - 150px);
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 999px;
    background: var(--rt-surface);
    box-shadow: 0 6px 20px rgb(20 16 12 / 0.12);
  }

  .lightbox-nav:hover {
    background: var(--rt-sand);
  }
</style>
