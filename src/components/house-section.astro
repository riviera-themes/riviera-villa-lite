---
import { Image } from 'astro:assets';
import { villa } from '../config/index.ts';
import { useI18n } from '../i18n/index.ts';
import type { Locale } from '../i18n/locales.ts';
import { photo } from '../lib/photos.ts';
import SectionHeading from './section-heading.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { ui, t } = useI18n(locale);
const { house } = villa;
const [mainImage, sideImage] = house.images;
const altFor = (file: string) => t(villa.gallery.find((g) => g.image === file)?.alt) || villa.property.name;
---

<section id="house" class="wrap py-[clamp(88px,11vw,150px)]" aria-labelledby="house-title">
  <div class="grid gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5 lg:pt-6">
      <SectionHeading id="house-title" eyebrow={ui.house.eyebrow} title={t(house.title)} />
      <p class="mt-8 max-w-[520px] font-serif text-[23px] leading-[1.45] text-ink/90">{t(house.intro)}</p>
      {
        house.facts.length > 0 && (
          <dl class="mt-12 grid grid-cols-2 gap-x-8 gap-y-7 border-t border-line pt-8 sm:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4">
            {house.facts.map((f) => (
              <div class="flex flex-col-reverse justify-end">
                <dt class="mt-1 text-[13px] text-muted">{t(f.label)}</dt>
                <dd class="font-serif text-[30px] leading-none whitespace-nowrap">{t(f.value)}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
    <div class="relative lg:col-span-7">
      <div class="grid grid-cols-12 items-end gap-3 sm:gap-4">
        <Image
          src={photo(mainImage)}
          alt={altFor(mainImage)}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1024px) 40vw, 66vw"
          class="col-span-8 aspect-[4/5] w-full rounded-[20px] object-cover"
        />
        <Image
          src={photo(sideImage)}
          alt={altFor(sideImage)}
          widths={[360, 540, 720]}
          sizes="(min-width: 1024px) 20vw, 33vw"
          class="col-span-4 mb-[18%] aspect-[3/4] w-full rounded-[18px] object-cover"
        />
      </div>
    </div>
  </div>

  <ol class="mt-[clamp(64px,8vw,110px)] grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
    {
      house.highlights.map((h, i) => (
        <li class="border-t border-line-strong pt-6">
          <span class="num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-5 text-[27px] leading-[1.1]">{t(h.title)}</h3>
          <p class="mt-3 text-[15px] leading-[1.65] text-muted">{t(h.text)}</p>
        </li>
      ))
    }
  </ol>
</section>
