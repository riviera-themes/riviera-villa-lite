---
import { villa } from '../config/index.ts';
import { useI18n } from '../i18n/index.ts';
import type { Locale } from '../i18n/locales.ts';
import Icon from './icon.astro';
import SectionHeading from './section-heading.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { ui, t } = useI18n(locale);
---

<section id="rules" class="border-t border-line py-[clamp(88px,11vw,150px)]" aria-labelledby="rules-title">
  <div class="wrap">
    <SectionHeading id="rules-title" eyebrow={ui.sections.rules.eyebrow} title={ui.sections.rules.title} />
    <ul class="mt-12 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3" role="list">
      {
        villa.rules.map((rule) => (
          <li class="flex gap-5 border-t border-line pt-6">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-surface text-accent-ink">
              <Icon name={rule.icon ?? 'check'} size={20} />
            </span>
            <div>
              <h3 class="text-[24px] leading-[1.15]">{t(rule.title)}</h3>
              <p class="mt-2 text-[15px] leading-[1.65] text-muted">{t(rule.text)}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
