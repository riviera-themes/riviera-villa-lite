---
import { villa } from '../config/index.ts';
import { useI18n } from '../i18n/index.ts';
import type { Locale } from '../i18n/locales.ts';
import Icon from './icon.astro';
import SectionHeading from './section-heading.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { ui, t } = useI18n(locale);
---

<section id="amenities" class="wrap py-[clamp(88px,11vw,150px)]" aria-labelledby="amenities-title">
  <SectionHeading id="amenities-title" eyebrow={ui.sections.amenities.eyebrow} title={ui.sections.amenities.title} />
  <div class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
    {
      villa.amenities.map((group) => (
        <div>
          <h3 class="border-b border-line-strong pb-4 text-[26px]">{t(group.group)}</h3>
          <ul class="mt-2" role="list">
            {group.items.map((item) => (
              <li class="flex items-start gap-3 border-b border-line py-[13px] text-[15px] leading-[1.45]">
                <Icon name={item.icon ?? 'check'} size={20} class="mt-[1px] shrink-0 text-accent-ink" />
                {t(item.label)}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
