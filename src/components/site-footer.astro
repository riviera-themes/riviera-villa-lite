---
import { villa } from '../config/index.ts';
import { pagePath, useI18n, type LayoutPage } from '../i18n/index.ts';
import type { Locale } from '../i18n/locales.ts';
import Icon from './icon.astro';
import LanguageSwitcher from './language-switcher.astro';

interface Props {
  locale: Locale;
  page: LayoutPage;
}

const { locale, page } = Astro.props;
const { ui, t } = useI18n(locale);
const { property, contact } = villa;
const home = (hash: string) => (page === 'home' ? hash : pagePath(locale, 'home', hash));
const s = villa.sections;
const year = new Date().getFullYear();

const links = [
  s.house && { href: home('#house'), label: t(villa.house.navLabel) },
  s.gallery && { href: home('#gallery'), label: ui.nav.gallery },
  s.area && { href: home('#area'), label: t(villa.area.navLabel) },
  s.rates && { href: home('#rates'), label: ui.nav.rates },
  s.reviews && villa.reviews.length > 0 && { href: home('#reviews'), label: ui.nav.reviews },
  s.booking && { href: home('#booking'), label: ui.nav.book },
].filter((l): l is { href: string; label: string } => Boolean(l));
---

<footer class="border-t border-line-strong pt-20 pb-28 lg:pb-12">
  <div class="wrap">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="font-serif text-[34px] uppercase leading-none tracking-[0.04em]">{property.name}</p>
        <p class="mt-4 max-w-[380px] text-[15px] leading-[1.6] text-muted">{t(property.tagline)}</p>
        <address class="mt-6 text-[14px] not-italic leading-[1.7] text-muted">
          {property.address.street}<br />
          {property.address.postalCode}
          {property.address.locality}, {property.address.region}
        </address>
      </div>

      <div class="lg:col-span-3">
        <h2 class="text-[13px] font-semibold uppercase tracking-[0.14em] text-muted" style="font-family: var(--rt-font-body);">
          {ui.footer.contact}
        </h2>
        <ul class="mt-5 space-y-3 text-[15px]" role="list">
          <li>
            <a href={`mailto:${contact.email}`} class="inline-flex items-center gap-2 hover:text-accent-ink">
              <Icon name="mail" size={18} />
              {contact.email}
            </a>
          </li>
          {
            contact.phone && (
              <li>
                <a href={`tel:${contact.phone.replace(/[^\d+]/g, '')}`} class="inline-flex items-center gap-2 hover:text-accent-ink">
                  <Icon name="phone" size={18} />
                  {contact.phone}
                </a>
              </li>
            )
          }
          {
            contact.whatsapp && (
              <li>
                <a href={`https://wa.me/${contact.whatsapp}`} class="inline-flex items-center gap-2 hover:text-accent-ink" rel="noopener" target="_blank">
                  <Icon name="whatsapp" size={18} />
                  WhatsApp
                </a>
              </li>
            )
          }
        </ul>
      </div>

      <nav class="lg:col-span-2" aria-label={villa.property.name}>
        <ul class="space-y-3 text-[15px]" role="list">
          {
            links.map((l) => (
              <li>
                <a href={l.href} class="hover:text-accent-ink">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:col-span-2">
        <LanguageSwitcher locale={locale} page={page} vertical />
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-line pt-6 text-[13px] text-muted lg:flex-row lg:items-center lg:justify-between">
      <p class="flex flex-wrap gap-x-5 gap-y-2">
        <span>{ui.footer.rights(year, property.name)}</span>
        {property.registrationNumber && <span>{ui.footer.registration} {property.registrationNumber}</span>}
        <a href={pagePath(locale, 'legal')} class="hover:text-ink">{ui.footer.legal}</a>
        <a href={pagePath(locale, 'privacy')} class="hover:text-ink">{ui.footer.privacy}</a>
      </p>
      <p>{ui.footer.madeWith}</p>
    </div>

    {
      villa.site.demoNotice && (
        <p class="mt-6 rounded-[14px] border border-line-strong px-5 py-4 text-[13.5px] leading-[1.6]">{t(villa.site.demoNotice)}</p>
      )
    }
  </div>
</footer>
