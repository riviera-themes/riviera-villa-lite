---
import RichTitle from './rich-title.astro';

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  intro?: string;
  class?: string;
}

const { id, eyebrow, title, intro, class: className } = Astro.props;
---

<div class:list={['max-w-[640px]', className]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="section-title mt-5"><RichTitle text={title} /></h2>
  {intro && <p class="mt-6 text-[17px] leading-[1.65] text-muted">{intro}</p>}
  <slot />
</div>
