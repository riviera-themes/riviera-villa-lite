---
/**
 * The one-page site: every section of the home page, in the order shown.
 * Reorder the lines below to reorder the sections; hide one with `sections` in villa.config.ts.
 */
import AmenitiesSection from '../components/amenities-section.astro';
import AreaSection from '../components/area-section.astro';
import BedroomsSection from '../components/bedrooms-section.astro';
import BookingForm from '../components/booking-form.astro';
import FaqSection from '../components/faq-section.astro';
import GallerySection from '../components/gallery-section.astro';
import Hero from '../components/hero.astro';
import HouseSection from '../components/house-section.astro';
import RatesSection from '../components/rates-section.astro';
import ReviewsSection from '../components/reviews-section.astro';
import RulesSection from '../components/rules-section.astro';
import { villa } from '../config/index.ts';
import { useI18n } from '../i18n/index.ts';
import type { Locale } from '../i18n/locales.ts';
import BaseLayout from '../layouts/base-layout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = useI18n(locale);
const s = villa.sections;
---

<BaseLayout locale={locale} page="home" title={t(villa.seo.title)} description={t(villa.seo.description)}>
  <Hero locale={locale} />
  {s.house && <HouseSection locale={locale} />}
  {s.gallery && <GallerySection locale={locale} />}
  {s.bedrooms && villa.bedrooms.rooms.length > 0 && <BedroomsSection locale={locale} />}
  {s.amenities && villa.amenities.length > 0 && <AmenitiesSection locale={locale} />}
  {s.area && <AreaSection locale={locale} />}
  {s.rates && <RatesSection locale={locale} />}
  {s.reviews && villa.reviews.length > 0 && <ReviewsSection locale={locale} />}
  {s.booking && <BookingForm locale={locale} />}
  {s.faq && villa.faq.length > 0 && <FaqSection locale={locale} />}
  {s.rules && villa.rules.length > 0 && <RulesSection locale={locale} />}
</BaseLayout>
